{
  "_comment": "Seed intent registry for the JARVIS voice layer. ~25 intents cover unlimited phrasings via the LLM router. Each maps to a real app action wired to the Core Engine. Examples are illustrative, not exhaustive — the LLM classifies any phrasing into these intents.",
  "wake": { "word": ["jarvis", "जार्विस"], "position": ["start", "end"], "clap_activate": { "claps": 2, "window_ms": 600 } },
  "languages": ["en-IN", "hi-IN", "hinglish"],
  "intents": [
    { "id": "nav.goto", "action": "navigate(section)", "slots": ["section"],
      "ex": { "en": "open the plan section", "hi": "प्लान खोलो", "hinglish": "plan wala section dikhao" } },
    { "id": "timer.start", "action": "focusTimer.start(minutes?)", "slots": ["minutes"],
      "ex": { "en": "start a 50 minute focus session", "hi": "पचास मिनट की पढ़ाई शुरू करो", "hinglish": "50 minute ka focus start karo" } },
    { "id": "timer.stop", "action": "focusTimer.stop()", "slots": [],
      "ex": { "en": "stop the timer", "hi": "टाइमर बंद करो", "hinglish": "timer band kar do" } },
    { "id": "score.add", "action": "core.addScore(score,max,category,subject?)", "slots": ["score","max","category","subject"],
      "ex": { "en": "add score 80 out of 100 prelims", "hi": "प्रीलिम्स में सौ में से अस्सी जोड़ो", "hinglish": "prelims mein 80 out of 100 add karo" } },
    { "id": "routine.setType", "action": "routine.setDayType(type)", "slots": ["type"],
      "ex": { "en": "mark today as holiday", "hi": "आज छुट्टी है", "hinglish": "aaj holiday mark karo" } },
    { "id": "routine.logHours", "action": "routine.setHours(n)", "slots": ["hours"],
      "ex": { "en": "log 6 hours of study", "hi": "छह घंटे पढ़ाई दर्ज करो", "hinglish": "6 ghante padhai log karo" } },
    { "id": "lecture.markDone", "action": "lectures.markDone(subject,number?)", "slots": ["subject","number"],
      "ex": { "en": "mark polity lecture 12 done", "hi": "पॉलिटी लेक्चर बारह पूरा", "hinglish": "polity lecture 12 done kar do" } },
    { "id": "query.backlog", "action": "core.queryBacklog()", "slots": [],
      "ex": { "en": "how many lectures are left", "hi": "कितने लेक्चर बचे हैं", "hinglish": "kitne lectures bache hai" } },
    { "id": "query.hours", "action": "core.queryHours(period?)", "slots": ["period"],
      "ex": { "en": "how many hours did I study today", "hi": "आज कितने घंटे पढ़ा", "hinglish": "aaj kitne ghante padha" } },
    { "id": "query.rank", "action": "core.queryRank()", "slots": [],
      "ex": { "en": "what's my rank projection", "hi": "मेरी रैंक प्रोजेक्शन बताओ", "hinglish": "meri rank projection batao" } },
    { "id": "query.selectionProb", "action": "core.querySelectionProbability()", "slots": [],
      "ex": { "en": "what's my selection probability", "hi": "मेरा सिलेक्शन चांस कितना है", "hinglish": "mera selection probability kitna hai" } },
    { "id": "query.average", "action": "core.queryAverage(stream)", "slots": ["stream"],
      "ex": { "en": "what's my optional average", "hi": "ऑप्शनल का औसत क्या है", "hinglish": "optional average kya hai" } },
    { "id": "plan.generate", "action": "planner.generate()", "slots": [],
      "ex": { "en": "generate my study plan", "hi": "मेरा प्लान बनाओ", "hinglish": "mera plan banao" } },
    { "id": "plan.today", "action": "planner.today()", "slots": [],
      "ex": { "en": "what should I study today", "hi": "आज क्या पढ़ूँ", "hinglish": "aaj kya padhna hai" } },
    { "id": "revision.due", "action": "srs.due()", "slots": [],
      "ex": { "en": "what's due for revision", "hi": "रिवीजन में क्या है", "hinglish": "aaj revision mein kya hai" } },
    { "id": "mistake.add", "action": "mistakes.add(text)", "slots": ["text"],
      "ex": { "en": "log a mistake", "hi": "गलती दर्ज करो", "hinglish": "mistake note karo" } },
    { "id": "ca.add", "action": "currentAffairs.add(text)", "slots": ["text"],
      "ex": { "en": "log current affairs about the budget", "hi": "बजट का करंट अफेयर जोड़ो", "hinglish": "budget ka CA add karo" } },
    { "id": "constitution.lookup", "action": "constitution.show(article)", "slots": ["article"],
      "ex": { "en": "show me article 21", "hi": "अनुच्छेद इक्कीस दिखाओ", "hinglish": "article 21 batao" } },
    { "id": "syllabus.show", "action": "syllabus.show(paper?)", "slots": ["paper"],
      "ex": { "en": "show the GS2 syllabus", "hi": "जीएस दो का सिलेबस", "hinglish": "GS2 syllabus dikhao" } },
    { "id": "countdown.exam", "action": "countdown.show(exam?)", "slots": ["exam"],
      "ex": { "en": "how many days to prelims", "hi": "प्रीलिम्स में कितने दिन", "hinglish": "prelims mein kitne din bache" } },
    { "id": "briefing.today", "action": "core.briefing()", "slots": [],
      "ex": { "en": "give me today's briefing", "hi": "आज का ब्रीफिंग दो", "hinglish": "aaj ka briefing sunao" } },
    { "id": "qa.answer", "action": "llm.answer(question)  // UPSC tutor mode", "slots": ["question"],
      "ex": { "en": "explain fundamental rights", "hi": "मौलिक अधिकार समझाओ", "hinglish": "fundamental rights samjhao" } },
    { "id": "system.setLanguage", "action": "voice.setLanguage(lang)", "slots": ["lang"],
      "ex": { "en": "switch to Hindi", "hi": "हिंदी में बोलो", "hinglish": "hindi mein switch karo" } },
    { "id": "system.repeat", "action": "voice.repeatLast()", "slots": [],
      "ex": { "en": "say that again", "hi": "फिर से बोलो", "hinglish": "dobara bolo" } },
    { "id": "system.sleep", "action": "voice.stopListening()", "slots": [],
      "ex": { "en": "stop listening", "hi": "सुनना बंद करो", "hinglish": "sun-na band karo jarvis" } }
  ],
  "router_contract": {
    "input": "raw transcript (any language) with the Jarvis wake word stripped",
    "output": "{ intent: <one of intents[].id>, params: {<slot>:<value>}, language: 'en'|'hi'|'hinglish', confidence: 0-1 }",
    "fallback": "if no intent matches and it's a knowledge question -> intent qa.answer; else ask the user to rephrase"
  }
}
